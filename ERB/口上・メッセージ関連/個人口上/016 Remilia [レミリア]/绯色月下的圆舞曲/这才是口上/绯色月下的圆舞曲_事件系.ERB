;### 口上色判定 ###################################
@M_KOJO_YUBE_COLOR_K16

;这里可以通过SETCOLOR设置自己的口上颜色
;在系统启用口上色设定后才可以触发
;例：SETCOLOR 0xC07070
IF MARK:16:反発刻印 >= 2
	SETCOLOR 0xFF0000
ELSEIF	TCVAR:16:発情
	SELECTCASE CFLAG:16:340
	CASE 0 TO 300
	SETCOLOR 0xF3E4FF
	CASE 301 TO 400 
	SETCOLOR 0xF5DCF5
	CASE 401 TO 500 
	SETCOLOR 0xF7D4EB
	CASE 501 TO 600 
	SETCOLOR 0xF9CCE1
	CASE 601 TO 650 
	SETCOLOR 0xFBB0D7
	CASE 651 TO 700 
	SETCOLOR 0xFDBCCD
	CASE 700 TO 1000 
	SETCOLOR 0xFFB6C1
	ENDSELECT
ELSE
	SETCOLOR 0xF3E4FF
ENDIF
