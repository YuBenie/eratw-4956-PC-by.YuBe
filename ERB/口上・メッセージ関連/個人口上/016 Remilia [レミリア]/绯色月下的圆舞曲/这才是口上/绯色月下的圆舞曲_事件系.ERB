;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	;IF STRCOUNT(SENSE, "かわいい/")
	;	PRINTFORMW 「收到了一份可爱的礼物」
	;ELSEIF 評価点 >= 800
	;	PRINTFORMW 「收到了一份非常漂亮的礼物」
	;ELSE
	;	PRINTFORMW 「收到了很漂亮的礼物」
	;ENDIF
	RETURN 1
