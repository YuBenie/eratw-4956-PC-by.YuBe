;==================================================
@M_KOJO_YUBE_EVENT_K16_20(ARG,ARG:1)
;口上主编号为LOCALS or RESULT
;--------------------------------------------------
;启用（=0, 非表示、1, 表示）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;通常回家
	;启用（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:317
			;诶嘿嘿时要睡觉所以回去了
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;约会中帰宅
	;启用（=0, 非表示、1, 表示）
