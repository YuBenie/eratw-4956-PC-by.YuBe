@YUBE_RAINBOW_SUB1(ARGS:0, ARG:0, ARG:1) ;三个参数：字符串、偏移量（彩虹色起始位置）、方向
#LOCALSIZE 3	;这是声明三个LOCAL局部数值变量
LOCAL:0 = GETCOLOR()		;存储色号
LOCAL:1 = STRLENSU(ARGS:0)	;计算目标字符串的字符数
FOR LOCAL:2, 0, LOCAL:1	;初始化循环变量
	;计算当前字符的彩虹色索引（正序模式）% 12 确保索引在 0-11 范围内（对应 12 种彩虹色，如 0 = 红，1 = 橙红，2 = 橙，…，11 = 紫）
	SETCOLOR GET_RAINBOW(ARG:1 ? 11 - (LOCAL:2 + ARG:0) % 12 # (LOCAL:2 + ARG:0) % 12)	;返回对应索引的 RGB 颜色值
	; 布尔型：真为紫→红 假为红→紫
	PRINTS CHARATU(ARGS:0, LOCAL:2)	;从目标字符串中提取第 LOCAL:2 个字符
NEXT
SETCOLOR LOCAL:0	;恢复调用函数前的原始文字颜色
RETURN RESULT



