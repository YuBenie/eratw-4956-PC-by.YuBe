@DQYUBE(ARGS, ARG:0 = 0, ARG:1)
#DIM 文字数
#DIM 検索数
#DIMS DYNAMIC SEXYMASTER   
; 这里的ARG:0有三种情况
; 0时输出完之后会删除当前行
; 1时正常输出
; 2时输出之后会变成灰色底色

; 后面的ARG:1代表显示速度

; 自改日志
; 计划修改的内容
; ↓↓↓↓↓↓↓↓↓↓↓↓↓
; 我看了一下DQPRINT和FADE的函数，发现DQ不能像
; ↑↑↑↑↑↑↑↑↑↑↑↑↑
LOCAL:0 = 0
SEXYMASTER = %他_她(MASTER)%
IF ARG:1 == 0
	ARG:1 = 8 + FLAG:チュート文速度
ENDIF
STRLENFORM %ARGS%
文字数 = RESULT:0
検索数 = 文字数 + 1
ARGS '= REPLACE(ARGS, "它", SEXYMASTER)
FOR LOCAL:0, 0, 検索数
	IF LOCAL:0 == 文字数
		IF ARG:0
			PRINTFORM %ARGS%
		ELSE
			REUSELASTLINE %ARGS%
		ENDIF
		WAIT
	ELSE
		SUBSTRING ARGS, 0, LOCAL:0
		REUSELASTLINE %RESULTS:0%
		TWAIT ARG:1, 1
	ENDIF
NEXT
IF ARG:0 == 0
	REUSELASTLINE 
ELSEIF ARG:0 == 2
	CLEARLINE 1
	CALL COLORMESSAGE(@"%ARGS%", 0x696969, 1)
ENDIF

@YUBERAINBOW2(ARGS:0, ARG:0, ARGS:1, ARGS:2, ARG:1 = 100, ARG:2, ARGS:3)
#LOCALSIZE 3
#LOCALSSIZE 2
ARG:2 = INRANGE(ARG:2, 0, 5) ? ARG:2 # 0
; 检查是否再0~5范围内，否则归零
LOCAL:1 = CURRENTREDRAW()
; 保存当前重绘状态
LOCAL:2 = STRLENSU(ARGS:1)
; 计算并储存字符串长度
LOCALS:0 = %GETFONT()%
; 获取当前字体
LOCALS:1 =
; 不知所云，感觉能删
ARGS:3 = \@ CHKFONT(ARGS:3) ? %ARGS:3% # %LOCALS:1% \@
; 检查指定ARGS:3的字体是否可用，否则用LOCALS:1的字体
IF !LINEISEMPTY()	;若当前行非空
	REDRAW 0	;停止重绘
	PRINTL 
	LOCALS:1 = %HTML_TOPLAINTEXT(HTML_GETPRINTEDSTR())%
	; 获取当前行已打印文本并转为纯文本、存储
	CLEARLINE 1
	PRINTS LOCALS:1
	; 清楚当前行后再打印出来
	REDRAW LOCAL:1
	; 恢复之前的重绘状态
ENDIF
;スクロール可(スクロールしないけど…まぁ、動いて見えるので)
IF ANIME_CONFIG("SCROLLTEXT")	;如果动画配置允许滚动文本
	FOR LOCAL:0, 0, ARG:0 - 1	;进行ARGS:0次循环
		SETFONT ARGS:3	;设置字体
		IF INRANGE(ARG:2, 0, 1)	;若在0~1之间
			PRINTS ARGS:1
			CALL _PRINT_RAINBOW_SUB1(ARGS:0, LOCAL:0, ARG:2) ;调用 _PRINT_RAINBOW_SUB1 函数处理 ARGS:0 字符串，实现彩虹色动画效果
			PRINTS ARGS:2
		ELSE
			CALL _PRINT_RAINBOW_SUB1(ARGS:1, LOCAL:0, INRANGE(ARG:2, 4, 5))	;调用 _PRINT_RAINBOW_SUB1 函数处理 ARGS:1 字符串
			PRINTS ARGS:0
			CALL _PRINT_RAINBOW_SUB1(ARGS:2, GROUPMATCH(ARG:2, 2, 5) ? LOCAL:0 + LOCAL:2 # 12 - LOCAL:2 - LOCAL:0, GROUPMATCH(ARG:2, 3, 5))	;调用 _PRINT_RAINBOW_SUB1 函数处理 ARGS:2 字符串
		ENDIF
		TWAIT ARG:1, 0	;等待若干毫秒
		CLEARLINE 1
		SETFONT LOCALS:0	;清楚当前行后恢复默认字体
		PRINTS LOCALS:1	;重新打印保存的纯文本
	NEXT
ENDIF
SETFONT ARGS:3	;设置字体
IF INRANGE(ARG:2, 0, 1)	;决定对两边字符串上色还是中间
	PRINTS ARGS:1
	CALL _PRINT_RAINBOW_SUB1(ARGS:0, LOCAL:0, ARG:2)
	PRINTS ARGS:2
ELSE
	CALL _PRINT_RAINBOW_SUB1(ARGS:1, LOCAL:0, INRANGE(ARG:2, 4, 5))
	PRINTS ARGS:0
	CALL _PRINT_RAINBOW_SUB1(ARGS:2, GROUPMATCH(ARG:2, 2, 5) ? LOCAL:0 + LOCAL:2 # 12 - LOCAL:2 - LOCAL:0, GROUPMATCH(ARG:2, 3, 5))
ENDIF
SETFONT LOCALS:0
RETURN RESULT

