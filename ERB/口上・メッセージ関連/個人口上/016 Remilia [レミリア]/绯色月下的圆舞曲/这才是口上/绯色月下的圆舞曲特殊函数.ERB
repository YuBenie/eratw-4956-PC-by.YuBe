SELECTCASE V_EVENT
	CASE "宴会"
		;  宴会开始与否1 参加者还是举办者2 宴会濒临尾声4 宴会前30分钟标记8 是否在会场16
		SELECTCASE CFLAG:ARG:20
			CASE 0
				RETURNF 
			CASE 1
				CLEARBIT LOCAL, 1
			CASE 2
				SETBIT LOCAL, 1
			CASE 3
				SETBIT LOCAL, 2
		ENDSELECT
		; 决定是参加者还是举办者、由于宴会结束不会区分举办者还是参加者

		SIF (TIME > FLAG:33 - 30) && (TIME < FLAG:33)
			SETBIT LOCAL, 8
		; 宴会前的三十分钟

		SIF 宴会開始日判定() && TIME >= FLAG:33
			SETBIT LOCAL, 0
		; 宴会开始

		SIF	CFLAG:ARG:300 == TFLAG:32
			SETBIT LOCAL, 4
		; 在不在会场
		V_RESULT = LOCAL
		LOCAL = 0
	CASEELSE
		V_RESULT = 10086
		
ENDSELECT
RETURNF V_RESULT

