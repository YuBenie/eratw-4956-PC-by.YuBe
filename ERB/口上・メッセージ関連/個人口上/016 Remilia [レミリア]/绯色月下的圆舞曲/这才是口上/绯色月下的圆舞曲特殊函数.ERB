;-------------------------------------------------
; 神秘铸币字体小函数
; 三个参数，应用的文本,是否带口上色开关,应用的STYLE
; 0 常规
; 1 粗体
; 2 斜体
; 4 删除
; 8 下划线
; 相加可叠加效果
; 使用举例：
; PRINTFORM	应用删除线前的文本
; PRINTFORM	%YUBE_FORNTSTYLE("删除线")%后面没有应用删除线的文本
; 实际表现为
; 应用删除线前的文本删除线后面没有应用删除线的文本
; 好吧个人能力限制，删除线前的文本必须在前一行单独PRINTFORM一下
;-------------------------------------------------
@YUBE_FONTSTYLE(ARGS,ARG,ARG:1)
#FUNCTIONS
FONTSTYLE ARG:1
SELECTCASE ARG
CASE 0
	PRINTFORMD	%ARGS%
CASE 1
	PRINTFORM	%ARGS%
ENDSELECT
FONTREGULAR
;-------------------------------------------------
; 神秘小功能、判断角色未陷落的函数
; 有点多此一举的感觉其实()
; 按顺序分别是恋人、恋慕、爱欲、思慕、炮友
; 如果要另做陷落状态，那么再另外考虑
;-------------------------------------------------
@YUBE_FALLEN(ARG)
#FUNCTION
#DIM CONST	FALLEN = 7, 3, 184, 8, 185
#DIM KEY
#DIM V_KEY
FOR LOCAL, 0 , 5
	KEY = FALLEN:LOCAL
	SIF TALENT:ARG:KEY
		SETBIT V_KEY,LOCAL
NEXT
RETURNF	V_KEY

